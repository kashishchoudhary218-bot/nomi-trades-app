# Copy to .env (git-ignored) for local runs. In Claude Code on the web, add these as
# environment variables in the environment settings instead.

# Which TTS provider `npm run voiceover` uses: kokoro (local, default) | elevenlabs | azure
TTS_PROVIDER=kokoro

# ElevenLabs — recommended for the final premium read
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Azure AI Speech — alternative
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# AZURE_SPEECH_VOICE=hi-IN-MadhurNeural

# Kokoro (local) — optional voice override: hm_omega (default) | hm_psi
# KOKORO_VOICE=hm_omega
