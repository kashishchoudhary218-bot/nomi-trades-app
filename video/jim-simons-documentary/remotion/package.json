{
  "name": "mathematicians-edge-documentary",
  "version": "1.0.0",
  "private": true,
  "description": "The Mathematician's Edge: Jim Simons documentary (Remotion)",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "studio": "npm run sync:assets && remotion studio",
    "render": "npm run sync:assets && remotion render Documentary out/the-mathematicians-edge.mp4",
    "render:draft": "npm run sync:assets && remotion render Documentary out/draft.mp4 --scale=0.5 --crf=28 --props='{\"showGuides\":true}'",
    "render:scene": "npm run sync:assets && remotion render",
    "thumbnail": "remotion still Thumbnail out/thumbnail.png",
    "srt": "tsx scripts/export-srt.ts",
    "validate": "tsx scripts/validate.ts",
    "qa": "npm run sync:assets && tsx scripts/qa-stills.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run validate",
    "assets": "tsx scripts/asset-manifest.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "@remotion/fonts": "4.0.527",
    "@remotion/media-utils": "4.0.527",
    "@remotion/transitions": "4.0.527",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.527",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "@types/react": "19.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
